# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Server-Side Free Tier Provider Keys (configured via AI Studio Secrets panel)
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""
GITHUB_TOKEN=""
